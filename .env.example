# =============================================================================
# Multi-Agent Medical Assistant - 环境变量模板
# =============================================================================
# 使用方式：
#   1) cp .env.example .env
#   2) 把下面带 ⚠️ 的项替换成你自己的值
#   3) 不需要的项可以删掉，留空 = 走代码内默认行为
#
# 安全：真正的 .env 文件已被 .gitignore 忽略，不会进版本库；只有这份模板
#       (.env.example) 会随仓库提交。请勿把任何真实密钥写到本文件！
# =============================================================================


# -----------------------------------------------------------------------------
# Heyi 远程分割服务（脑卒中 CT 分割 v2.0）
# -----------------------------------------------------------------------------
# 同学部署的 FastAPI 服务，BrainStrokeAgent 会优先调用它做真实推理；
# 无法访问时自动降级到本地 HeyiVisionAdapter 的演示模式。
#
# - HEYI_REMOTE_URL 留空时，BrainStrokeAgent 会跳过远程，永远只走本地。
# - 健康检查 (/health) 失败一次就降级，不会反复尝试拖慢请求。

HEYI_REMOTE_URL=http://222.198.105.83:8000
HEYI_REMOTE_ENABLED=true
HEYI_REMOTE_TIMEOUT=120
HEYI_REMOTE_HEALTH_TIMEOUT=3
# auto / hemorrhage / ischemia
HEYI_REMOTE_TASK=auto


# -----------------------------------------------------------------------------
# 第三方服务密钥（⚠️ 替换成你自己的，不要提交真实值）
# -----------------------------------------------------------------------------

# 智谱 AI（必填，仅用于 embedding-3 和 glm-4v-flash 视觉模型）
ZHIPU_API_KEY=
# 可选：默认已内置 https://open.bigmodel.cn/api/paas/v4/
ZHIPU_BASE_URL=

# MiMo / 小米 Token Plan（必填，用作所有聊天 LLM）
# Token Plan key 形如 tp-xxx
MIMO_API_KEY=
# 可选：默认 https://token-plan-cn.xiaomimimo.com/v1
MIMO_BASE_URL=
# 可选：默认 mimo-v2.5-pro
MIMO_CHAT_MODEL=

# Tavily（Web Search Agent 必填）
TAVILY_API_KEY=

# Qdrant Cloud（仅使用 RAG 时需要）
QDRANT_URL=
QDRANT_API_KEY=

# HuggingFace Hub Token（用于下载某些受限模型 / reranker）
HUGGINGFACE_TOKEN=

# ElevenLabs 文本转语音（用于 SpeechConfig）
ELEVEN_LABS_API_KEY=

# 百度语音（使用 /transcribe 时需要）
BAIDU_API_KEY=
BAIDU_SECRET_KEY=


# -----------------------------------------------------------------------------
# 离线 / 降级开关
# -----------------------------------------------------------------------------
# FORCE_OFFLINE_MODE=true       -> 全部请求只走本地兜底回应器
# ENABLE_OFFLINE_FALLBACK=true  -> 在线流水线异常时自动降级到本地

FORCE_OFFLINE_MODE=false
ENABLE_OFFLINE_FALLBACK=true

# -----------------------------------------------------------------------------
# LangGraph 持久化断点（Checkpoint）
# -----------------------------------------------------------------------------
# LANGGRAPH_CHECKPOINT_BACKEND        -> "sqlite"（默认，进程重启不丢历史）
#                                        或 "memory"（仅进程内有效，测试用）
# LANGGRAPH_CHECKPOINT_SQLITE_PATH    -> SQLite 文件路径，仅 backend=sqlite 生效
LANGGRAPH_CHECKPOINT_BACKEND=sqlite
LANGGRAPH_CHECKPOINT_SQLITE_PATH=./data/langgraph_checkpoints.sqlite
# 是否启用 checkpoint 过期清理
LANGGRAPH_CHECKPOINT_CLEANUP_ENABLED=true
# 保留最近 N 天活跃会话
LANGGRAPH_CHECKPOINT_RETENTION_DAYS=30
# 清理任务运行间隔，默认每天一次
LANGGRAPH_CHECKPOINT_CLEANUP_INTERVAL_SECONDS=86400
